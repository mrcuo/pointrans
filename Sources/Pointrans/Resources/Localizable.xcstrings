{
  "sourceLanguage": "en",
  "strings": {
    "A real context result is unavailable. Check your network or enable Apple Intelligence, then retry.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法获得真实语境结果。请检查网络或启用 Apple 智能后重试。"
          }
        }
      }
    },
    "AI context": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 语境"
          }
        }
      }
    },
    "Accessibility": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能"
          }
        }
      }
    },
    "Accessibility is required": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要辅助功能权限"
          }
        }
      }
    },
    "All built-in translation routes failed. Check the language capability and try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有内置翻译路径均失败。请检查语言能力后重试。"
          }
        }
      }
    },
    "Allow Accessibility": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许辅助功能"
          }
        }
      }
    },
    "Allow Screen Recording": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许屏幕录制"
          }
        }
      }
    },
    "An explanation isn't available on this Mac right now.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 目前无法生成解释。"
          }
        }
      }
    },
    "Apple Translation": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 翻译"
          }
        }
      }
    },
    "Asked only if it is needed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在确实需要时询问"
          }
        }
      }
    },
    "Back": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回"
          }
        }
      }
    },
    "Both required permissions must remain enabled.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "必须保持两项必需权限均已启用。"
          }
        }
      }
    },
    "Built-in translation": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置翻译能力"
          }
        }
      }
    },
    "Check online again": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新检查在线解释"
          }
        }
      }
    },
    "Chinese → English": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中文 → 英文"
          }
        }
      }
    },
    "Click “Explain in this sentence” in the card": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击翻译卡里的“解释这个词在句子里的意思”"
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        }
      }
    },
    "Cloud": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云端"
          }
        }
      }
    },
    "Cloud context quota is exhausted. Try again after it resets.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云端语境额度已用完，请在额度重置后重试。"
          }
        }
      }
    },
    "Cloud context quota resets at %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云端语境额度将在 %@ 重置。"
          }
        }
      }
    },
    "Cloud · %d remaining": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云端 · 剩余 %d 次"
          }
        }
      }
    },
    "Context insight": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语境解释"
          }
        }
      }
    },
    "Context insight is temporarily unavailable.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语境解释暂时不可用。"
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续"
          }
        }
      }
    },
    "Continue in the translation card": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在翻译卡中继续"
          }
        }
      }
    },
    "Copy": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制"
          }
        }
      }
    },
    "Done — keep using the result card.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成了，结果卡可以继续使用。"
          }
        }
      }
    },
    "English and Chinese are detected automatically": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动识别英文与中文"
          }
        }
      }
    },
    "English → Chinese": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "英文 → 中文"
          }
        }
      }
    },
    "Explain in this sentence": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解释这个词在句子里的意思"
          }
        }
      }
    },
    "Explain this word in its sentence": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解释这个词在当前句子中的含义"
          }
        }
      }
    },
    "Great — keep holding for a moment.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "很好，再保持一下。"
          }
        }
      }
    },
    "Hold Left Option and hover": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住左 Option 并悬停"
          }
        }
      }
    },
    "Hold Left Option and keep the pointer over English or Chinese text. Pointrans detects the language and shows the translation beside your pointer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住左 Option，把光标停在英文或中文文字上。Pointrans 会自动识别语言，并在光标旁显示翻译。"
          }
        }
      }
    },
    "Hold still for a moment": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持光标不动片刻"
          }
        }
      }
    },
    "Hover delay": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "悬停延迟"
          }
        }
      }
    },
    "In this sentence": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这句话里"
          }
        }
      }
    },
    "Keep the pointer still until the real translation card appears.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持光标不动，直到真实翻译卡出现。"
          }
        }
      }
    },
    "Language capability is ready": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语言能力已就绪"
          }
        }
      }
    },
    "Language preparation could not finish. Check your connection and try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语言能力准备失败。请检查网络后重试。"
          }
        }
      }
    },
    "Left Option recognized": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已识别左 Option"
          }
        }
      }
    },
    "Local definition": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地释义"
          }
        }
      }
    },
    "Looking up this word…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取这个词…"
          }
        }
      }
    },
    "Move back to the blue word and repeat the same gesture.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把光标移回蓝色单词，再做一次相同操作。"
          }
        }
      }
    },
    "Move the pointer onto the blue word, then hold Left Option.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把光标移到蓝色单词上，然后按住左 Option。"
          }
        }
      }
    },
    "Never sends text online": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绝不在线发送文字"
          }
        }
      }
    },
    "No other action is needed. The real result will stay open when setup finishes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在无需进行其他操作。设置结束后，真实结果仍会保持打开。"
          }
        }
      }
    },
    "No supported word was found.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "光标处没有可识别的中英文词语。"
          }
        }
      }
    },
    "Not now": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不使用"
          }
        }
      }
    },
    "Offline dictionary": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地词典"
          }
        }
      }
    },
    "Offline dictionary · OCR": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地词典 · OCR"
          }
        }
      }
    },
    "On this Mac": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac"
          }
        }
      }
    },
    "On-device": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备端"
          }
        }
      }
    },
    "On-device AI": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备端 AI"
          }
        }
      }
    },
    "Online": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在线"
          }
        }
      }
    },
    "Online context explanation": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在线语境解释"
          }
        }
      }
    },
    "Online explanation couldn't finish.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在线解释暂时未能完成。"
          }
        }
      }
    },
    "Online explanation needs a service update.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在线解释服务需要更新。"
          }
        }
      }
    },
    "Open Control Center": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开控制中心"
          }
        }
      }
    },
    "Open Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开设置"
          }
        }
      }
    },
    "Open System Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开系统设置"
          }
        }
      }
    },
    "Pause Translation": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停翻译"
          }
        }
      }
    },
    "Permission granted": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "权限已授予"
          }
        }
      }
    },
    "Pinned": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已固定"
          }
        }
      }
    },
    "Point at a word. Understand it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指向一个词，即刻理解。"
          }
        }
      }
    },
    "Point to the blue word and hold Left Option": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把光标指向蓝色单词，按住左 Option"
          }
        }
      }
    },
    "Pointrans can use an online explanation with only this word and its sentence. It never sends a screenshot or the app you're using.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pointrans 可以只用这个词和所在句子在线生成解释；绝不会发送截图或你正在使用的应用信息。"
          }
        }
      }
    },
    "Pointrans could not create its menu bar item and will quit.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pointrans 无法创建菜单栏图标，将自动退出。"
          }
        }
      }
    },
    "Pointrans could not start": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pointrans 无法启动"
          }
        }
      }
    },
    "Pointrans is explaining this sentence": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pointrans 正在解释这句话"
          }
        }
      }
    },
    "Pointrans is preparing Apple's on-device translation languages. This built-in capability must be ready before the guided experience.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pointrans 正在准备 Apple 设备端中英翻译语言。完成后才能进入引导体验。"
          }
        }
      }
    },
    "Pointrans is reading the sentence. No other action is needed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pointrans 正在理解这句话，无需进行其他操作。"
          }
        }
      }
    },
    "Pointrans is ready. Try it here.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pointrans 已经可以用了，在这里试一次。"
          }
        }
      }
    },
    "Pointrans needs attention": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pointrans 需要处理"
          }
        }
      }
    },
    "Pointrans will explain this exact use.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pointrans 会解释这个词在当前句子里的含义。"
          }
        }
      }
    },
    "Preparing English and Chinese": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在准备中英语言能力"
          }
        }
      }
    },
    "Preparing language capability…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在准备语言能力…"
          }
        }
      }
    },
    "Press Left Option once to continue": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下左 Option 继续"
          }
        }
      }
    },
    "Pronounce": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "朗读"
          }
        }
      }
    },
    "Quit": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出"
          }
        }
      }
    },
    "Quit Pointrans": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出 Pointrans"
          }
        }
      }
    },
    "Quit and reopen Pointrans": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出后重新打开 Pointrans"
          }
        }
      }
    },
    "Reading the blue word…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取蓝色单词…"
          }
        }
      }
    },
    "Reading the word under your pointer…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取光标下的单词…"
          }
        }
      }
    },
    "Reading…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在取词…"
          }
        }
      }
    },
    "Ready": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "就绪"
          }
        }
      }
    },
    "Ready to translate": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以翻译"
          }
        }
      }
    },
    "Required": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "必需"
          }
        }
      }
    },
    "Required for text inside images, PDFs, and apps that do not expose readable text. Only a small area near the pointer is processed on this Mac; screenshots are never saved or uploaded.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取图片、PDF 和无法提供文字的应用时必需。只在这台 Mac 上处理光标附近的小范围画面；截图绝不会保存或上传。"
          }
        }
      }
    },
    "Required to listen for Left Option and read the word under your pointer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "监听左 Option 并读取光标下的文字时必需。"
          }
        }
      }
    },
    "Restart Pointrans to finish this permission. Your setup progress is saved.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新启动 Pointrans 以完成此权限设置。你的设置进度已保存。"
          }
        }
      }
    },
    "Restoring text detection…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在恢复取词监听…"
          }
        }
      }
    },
    "Resume Translation": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续翻译"
          }
        }
      }
    },
    "Retry": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        }
      }
    },
    "Screen Recording": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕录制"
          }
        }
      }
    },
    "Screen Recording is required": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要屏幕录制权限"
          }
        }
      }
    },
    "See what it means in this sentence": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看看它在这句话里是什么意思"
          }
        }
      }
    },
    "Setup finishes automatically after the two actions.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成上面两个动作后会自动结束设置。"
          }
        }
      }
    },
    "Setup is required": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要完成首次设置"
          }
        }
      }
    },
    "Setup will close automatically; your real result stays open.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置窗口会自动关闭，真实结果卡会继续保留。"
          }
        }
      }
    },
    "Starting…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在启动…"
          }
        }
      }
    },
    "Step %d of 5": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %d 步，共 5 步"
          }
        }
      }
    },
    "Text detection needs attention": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取词监听需要处理"
          }
        }
      }
    },
    "That's it — Pointrans is ready in your menu bar.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "就是这样，Pointrans 已在菜单栏就绪。"
          }
        }
      }
    },
    "The blue action at the bottom of the real card completes the experience.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击真实翻译卡底部的蓝色操作即可完成体验。"
          }
        }
      }
    },
    "The blue word is the target. Pointrans responds while Left Option is held.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蓝色单词就是目标；按住左 Option 时，Pointrans 会立即响应。"
          }
        }
      }
    },
    "The built-in dictionary is missing or damaged. Reinstall Pointrans.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置词典缺失或损坏，请重新安装 Pointrans。"
          }
        }
      }
    },
    "The explanation is not available on this Mac right now.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 目前无法生成解释。"
          }
        }
      }
    },
    "The explanation is temporarily unavailable.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解释暂时不可用。"
          }
        }
      }
    },
    "The guided action did not finish. Keep the pointer on the sample and try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "引导操作尚未完成。请把光标停在示例目标词上后重试。"
          }
        }
      }
    },
    "The real translation card is beside your pointer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "真实翻译卡就在光标旁。"
          }
        }
      }
    },
    "The required Apple Translation language pair is unavailable on this Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 无法使用必需的 Apple 中英翻译语言。"
          }
        }
      }
    },
    "The result card shows one clear recovery action. Follow it there; your translation is preserved.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "翻译卡里会显示唯一的恢复操作；按提示操作即可，已有翻译不会丢失。"
          }
        }
      }
    },
    "The selected text cannot be analyzed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法分析所选文字。"
          }
        }
      }
    },
    "The setup window closes automatically after the real explanation appears.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "真实解释出现后，设置窗口会自动关闭。"
          }
        }
      }
    },
    "The translation will appear beside your pointer, just like normal use.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "翻译会像日常使用一样直接出现在光标旁。"
          }
        }
      }
    },
    "The word translation is complete, but the online explanation service is not ready for this version yet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上面的单词已经翻译完成，但在线解释服务尚未适配当前版本。"
          }
        }
      }
    },
    "The word translation is complete. Try this Mac again or check the online explanation.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上面的单词已经翻译完成。可以重试这台 Mac，或重新检查在线解释。"
          }
        }
      }
    },
    "This Mac couldn't create the extra explanation.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 暂时无法生成进一步解释。"
          }
        }
      }
    },
    "This context cannot be analyzed on device.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此语境无法在设备端分析。"
          }
        }
      }
    },
    "This is the real Pointrans interaction—not a simulated result. The translation card will appear beside your pointer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里使用的就是 Pointrans 日常交互，不是模拟结果。翻译卡会直接出现在光标旁。"
          }
        }
      }
    },
    "To continue, Pointrans can send only “breakthrough” and this sample sentence for an online explanation. It never sends a screenshot or the app you're using.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如需继续，Pointrans 只会发送“breakthrough”和这句示例文字来在线生成解释；绝不会发送截图或你正在使用的应用信息。"
          }
        }
      }
    },
    "Today's cloud context quota is used up. On-device analysis remains available.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今日云端语境额度已用完，设备端分析仍可使用。"
